# ==============================================================================
# Astra Healthcare Platform — Backend Environment Configuration Example
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env`:
#      cp .env.example .env
# 2. Fill in the values with your actual secrets and API credentials.
# 3. NEVER commit the real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Connection string for MongoDB (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
DB_NAME=astra_db

# ------------------------------------------------------------------------------
# 2. Redis Session & Cache Store (Optional for memory fallback)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Email Notification (SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
# For Gmail: Use a 16-character Google App Password (not your normal email password).
# How to get: Google Account -> Security -> 2-Step Verification -> App passwords.
# If left blank, login credentials will display on the admin screen for demo mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Astra Healthcare

# ------------------------------------------------------------------------------
# 5. Frontend Application URL (CORS Configuration)
# ------------------------------------------------------------------------------
# URL where your React frontend is running
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Sarvam AI (Indic LLM, STT, and TTS Service)
# ------------------------------------------------------------------------------
# Sign up at: https://www.sarvam.ai/
# Required for Indic voice conversation, speech recognition, and clinical summary
SARVAM_AI_API_KEY=your_sarvam_ai_api_key_here

# ------------------------------------------------------------------------------
# 7. OpenAI (Vector Embeddings for Pinecone RAG)
# ------------------------------------------------------------------------------
# Sign up at: https://platform.openai.com/
# Used with `text-embedding-3-small` (1536 dim) for symptom vector search
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 8. Pinecone Vector Database (Disease Differential Retrieval)
# ------------------------------------------------------------------------------
# Sign up at: https://www.pinecone.io/
# Used to store and query the 770+ disease symptom vector profiles
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=astra-diseases

# ------------------------------------------------------------------------------
# 9. Cloudinary Image Storage (Prescription & Document Capture)
# ------------------------------------------------------------------------------
# Sign up at: https://cloudinary.com/
# Used to securely store scanned medical prescriptions and lab reports.
# Fallback: If not configured, images are stored locally under /uploads/prescriptions.
CLOUDINARY_API_KEY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
