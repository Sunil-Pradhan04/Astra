# ==============================================================================
# Astra Healthcare Platform — Frontend Environment Configuration Example
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env` or `.env.local` if custom API URL is needed:
#      cp .env.example .env
# 2. In local development, Vite defaults to http://localhost:8000/api if unset.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api
