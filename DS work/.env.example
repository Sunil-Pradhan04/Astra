# ==============================================================================
# Astra Healthcare Platform — Data Science / Vector Ingestion Environment
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env`:
#      cp .env.example .env
# 2. Fill in the values with your actual OpenAI and Pinecone API keys.
# 3. Used by `upload_to_pinecone.py`, `patient_triage_llm.py`, and `DS.ipynb`.
# ==============================================================================

# OpenAI API Key (used for `text-embedding-3-small` and triage LLM testing)
# Sign up at: https://platform.openai.com/
OPEN_AI_API=your_openai_api_key_here

# Pinecone Serverless Vector Database
# Sign up at: https://www.pinecone.io/
PINECONE_INDEX=astra-diseases
PINECONE_API_KEY=your_pinecone_api_key_here
