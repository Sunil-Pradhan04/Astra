# ==============================================================================
# Astra Healthcare Platform — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env
*.pem
*.key
*.cert
credentials.json
client_secrets.json

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Bundles
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/

# ------------------------------------------------------------------------------
# 4. Jupyter Notebook Checkpoints & Data Science Temp
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 5. Model Caches & Framework Weights
# ------------------------------------------------------------------------------
.cache/
.paddlex/
.torch/
.huggingface/
checkpoints/

# ------------------------------------------------------------------------------
# 6. User Uploads, Audio Records & Test Media
# ------------------------------------------------------------------------------
backend/uploads/prescriptions/*
!backend/uploads/prescriptions/.gitkeep
backend/app/Local TTS/*.wav
*.webm
*.mp3
*.wav
*.ogg

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
